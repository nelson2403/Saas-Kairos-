# =============================================================
# SAS KAIRÓS — variáveis de ambiente
# Copie para .env.local (nunca versionado) e preencha.
# Na Vercel: Settings → Environment Variables (Preview e Production separados).
# =============================================================

# URL pública do site (metadados, Open Graph, links em mensagens)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (sb_publishable_...). Segura no navegador: o acesso é limitado pelo RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA (sb_secret_...). SOMENTE servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Chave para criptografar credenciais de integrações (Asaas, Evolution) no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave invalida as credenciais salvas (será preciso informá-las de novo).
INTEGRATIONS_ENCRYPTION_KEY=

# Opcional: ativa o Service Worker em `next dev` (padrão: só em produção)
# NEXT_PUBLIC_ENABLE_SW_DEV=true
